<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ device transfer policy. We opt out of all cloud backup
    and device-to-device transfer; allowBackup="false" in the manifest
    already conveys the same intent for the legacy backup API. This file
    silences the Play Console warning by being explicit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
